# -------------------------------
# RoboUsr environment variables
# Copy this file to `.env` and fill in your real values.
# -------------------------------

# --- Telegram (Telethon) ---
API_ID=123456
API_HASH=abcdef1234567890abcdef1234567890
# Session filename for Telethon (creates/uses ./robosession.session)
SESSION_NAME=robosession
# Optional: used only by the one-time login helper (python -m telegram.login)
PHONE_NUMBER=+10000000000

# --- MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=telegram_bot
DB_USER=botuser
DB_PASSWORD=botpassword

# --- Local LLM (llama.cpp OpenAI-compatible server) ---
# Make sure your llama-cpp server is running on this host:port and path.
OPENAI_API_BASE=http://127.0.0.1:8001/v1
OPENAI_API_KEY=local-llama
LLAMA_MODEL_NAME=saiga-llama3-8b

# Optional knobs for the model server script
LLAMA_MODEL_PATH=./models/model-q4_K.gguf
LLAMA_THREADS=4
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8001

# --- FastAPI (optional; only used by start_bot.sh / __main__) ---
APP_HOST=127.0.0.1
APP_PORT=8000
